APP_NAME=FreshMart
APP_VERSION=1.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true
SESSION_DRIVER=file
SESSION_LIFETIME=30
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Local/demo seeding only. Set strong, deployment-specific values before
# intentionally running seeders in any non-local environment.
FRESHMART_ADMIN_USERNAME=admin
FRESHMART_ADMIN_NAME="System Administrator"
FRESHMART_ADMIN_PASSWORD=test123
FRESHMART_SEED_DEMO=true
FRESHMART_DEMO_PASSWORD=test123
